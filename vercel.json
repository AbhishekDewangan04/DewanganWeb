{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/apps/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|apps/).*)",
      "destination": "/index.html"
    }
  ]
}
